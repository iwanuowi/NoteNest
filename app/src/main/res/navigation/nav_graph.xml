<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.miniprojectnotebook.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.miniprojectnotebook.ui.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.miniprojectnotebook.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_home_to_register"
            app:destination="@+id/registerFragment"/>
        <action
            android:id="@+id/action_home_to_addNote"
            app:destination="@id/addNoteFragment" />
        <action
            android:id="@+id/action_home_to_noteDetail"
            app:destination="@id/noteDetailFragment" />
        <action
            android:id="@+id/action_home_to_trash"
            app:destination="@id/trashFragment" />
    </fragment>

    <fragment
        android:id="@+id/addNoteFragment"
        android:name="com.example.miniprojectnotebook.ui.manage.add.AddNoteFragment"
        android:label="New Note" />


    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.miniprojectnotebook.ui.detail.NoteDetailFragment"
        android:label="Note Details">

        <action
            android:id="@+id/action_noteDetail_to_editNote"
            app:destination="@id/editNoteFragment" />

    </fragment>

    <fragment
        android:id="@+id/editNoteFragment"
        android:name="com.example.miniprojectnotebook.ui.edit.EditNoteFragment"
        android:label="Edit Note" />
    <fragment
        android:id="@+id/trashFragment"
        android:name="com.example.miniprojectnotebook.ui.trash.TrashFragment"
        android:label="Trash" />

</navigation>
