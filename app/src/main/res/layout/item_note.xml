<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginBottom="12dp"
            android:background="#A7BC98" />

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note title"
            android:textColor="#303B2C"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Note content"
            android:textColor="#77766E"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnRestoreNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Restore note"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDeletePermanently"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Delete permanently"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
